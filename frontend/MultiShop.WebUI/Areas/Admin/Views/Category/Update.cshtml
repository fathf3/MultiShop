@model UpdateCategoryDto
@{
    ViewData["Title"] = "Update";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}



<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Kategori Güncelle</h4>
                <p class="card-description">
                    Basic form layout
                </p>
                <form class="forms-sample" method="post">
                    <input type="hidden" asp-for="Id"> 
                    <div class="form-group">
                        <label for="@Model.CategoryName">Kategori Adı</label>
                        <input type="text" class="form-control"  asp-for="CategoryName">
                    </div>
                    <div class="form-group">
                        <label for="@Model.ImageUrl">Kategori Resmi</label>
                        <input type="text" class="form-control" asp-for="ImageUrl">
                    </div>
                    <button type="submit" class="btn btn-primary mr-2">Güncelle</button>
                    <button type="button" class="btn btn-secondary" onclick="history.back()">
                        İptal
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>