@model List<ResultAboutDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <a class="btn btn-primary mb-3" href="/Admin/About/Create">
                Hakkımda Yazısı Ekle
            </a>
            <br>
            <div class="table-responsive pt-3">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>
                                Id
                            </th>
                            <th>
                               Açıklama
                            </th>
                            <th>
                                Adres
                            </th>
                            <th>
                                Telefon
                            </th>
                            <th>
                                Mail
                            </th>
                            <th>
                                Sil
                            </th>
                            <th>
                                Güncelle
                            </th>

                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var About in Model)
                        {
                            <tr>
                                <td>
                                    @About.Id
                                </td>
                                <td>
                                    @About.Description
                                </td>
                                <td>
                                    @About.Address
                                </td>
                                <td>
                                    @About.Phone
                                </td>
                                <td>
                                    @About.Email
                                </td>
                                <td>
                                    <a href="/Admin/About/DeleteAbout/@About.Id" class="btn btn-danger">Sil</a>
                                </td>
                                <td>
                                    <a href="/Admin/About/UpdateAbout/@About.Id" class="btn btn-info">Güncelle</a>
                                </td>

                            </tr>
                        }


                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

