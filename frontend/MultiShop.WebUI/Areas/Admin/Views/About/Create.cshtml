@model CreateAboutDto
@{
    ViewData["Title"] = "Create";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Yeni Hakkımızda Yazısı Ekle</h4>

            <form class="forms-sample" method="post">
                <div class="form-group">
                    <label for="exampleInputName1">Açıklama</label>
                    <input type="text" class="form-control" asp-for="Description" placeholder="Açıklama">
                </div>
                <div class="form-group">
                    <label for="exampleInputName1">Adres</label>
                    <input type="text" class="form-control" asp-for="Address" placeholder="Adres">
                </div>
                <div class="form-group">
                    <label for="exampleInputName1">Telefon</label>
                    <input type="text" class="form-control" asp-for="Phone" placeholder="Telefon">
                </div>
                <div class="form-group">
                    <label for="exampleInputName1">Email</label>
                    <input type="text" class="form-control" asp-for="Email" placeholder="Email">
                </div>


                <button type="submit" class="btn btn-primary mr-2">Gönder</button>

            </form>
        </div>
    </div>
</div>


