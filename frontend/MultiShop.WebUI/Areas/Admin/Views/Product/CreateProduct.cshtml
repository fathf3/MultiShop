@model CreateProductDto
@{
    ViewData["Title"] = "Create";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Yeni Ürün Ekle</h4>

            <form class="forms-sample" method="post">
                <div class="form-group">
                    <label for="exampleInputName1">Ürün Adı</label>
                    <input type="text" class="form-control" asp-for="ProductName" placeholder="Ürün Adı">
                </div>
                <div class="form-group">
                    <label for="exampleInputEmail3">Ürün Fiyatı</label>
                    <input type="number" class="form-control" asp-for="ProductPrice" placeholder="Ürün fiyatı">
                </div>

                <div class="form-group">
                    <label for="exampleSelectGender">Ürün Kategorisi</label>
                    @Html.DropDownListFor(x => x.CategoryID, (List<SelectListItem>)ViewBag.Categories, new { @class = "form-control" })
                </div>
                <div class="form-group">
                    <label>Ürün Görseli</label>
                    <input type="text" class="form-control" asp-for="ProductImageUrl">
                    @* <input type="file" name="img[]" class="file-upload-default">
                    <div class="input-group col-xs-12">
                        <input type="text" class="form-control file-upload-info" disabled="" placeholder="Upload Image">
                        <span class="input-group-append">
                            <button class="file-upload-browse btn btn-primary" type="button">Yükle</button>
                        </span>
                    </div> *@
                </div>

                <div class="form-group">
                    <label for="exampleTextarea1">Ürün Açıklaması</label>
                    <textarea class="form-control" asp-for="ProductDescription" rows="4"></textarea>
                </div>
                <button type="submit" class="btn btn-primary mr-2">Gönder</button>

            </form>
        </div>
    </div>
</div>

