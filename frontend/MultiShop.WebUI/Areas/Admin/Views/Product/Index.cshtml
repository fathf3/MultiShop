@model IEnumerable<ResultProductDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <a class="btn btn-primary mb-3" href="/Admin/Product/CreateProduct">
                Yeni Ürün Ekle
            </a>
            <br>
            <div class="table-responsive pt-3">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>
                                Görsel
                            </th>
                            <th>
                                Ürün Adı
                            </th>
                            <th>
                                Fiyat
                            </th>
                         
                            <th>
                                Sil
                            </th>
                            <th>
                                Güncelle
                            </th>
                            <th>
                                Ürün Görselleri
                            </th>
                            <th>
                                Ürün Açıklamaları
                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var Product in Model)
                        {
                            <tr>
                                <td>
                                    @Product.ProductImageUrl
                                </td>
                                <td>
                                    @Product.ProductName
                                </td>
                                <td>
                                    @Product.ProductPrice
                                </td>
                                                             
                                <td>
                                    <a href="/Admin/Product/DeleteProduct/@Product.Id" class="btn btn-danger">Sil</a>
                                </td>
                                <td>
                                    <a href="/Admin/Product/UpdateProduct/@Product.Id" class="btn btn-info">Güncelle</a>
                                </td>
                                <td>
                                    <a href="/Admin/ProductDetail/UpdateProductDetail/@Product.Id" class="btn btn-warning">Ürün Görselleri</a>
                                </td>
                                <td>
                                    <a href="/Admin/ProductDetail/UpdateProductDetail/@Product.Id" class="btn btn-warning">Ürün Açıklamaları</a>
                                </td>

                            </tr>
                        }


                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>


