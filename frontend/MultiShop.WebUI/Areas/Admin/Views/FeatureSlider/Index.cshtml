@model List<ResultFeatureSliderDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    int count = 1;
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <a class="btn btn-primary mb-3" href="/Admin/FeatureSlider/Create">
                Yeni Slider Ekle
            </a>
            <br>
            <div class="table-responsive pt-3">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                Başlık
                            </th>
                            <th>
                                Açıklama
                            </th>
                            <th>
                                Resim
                            </th>
                            <th>
                                Durum
                            </th>
                            <th>
                                Sil
                            </th>
                            <th>
                                Güncelle
                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            count++;
                            <tr>
                                <td>
                                    @count
                                </td>
                                <td>
                                   @item.Title
                                </td>
                                <td>
                                    @item.Description
                                </td>
                                <td>
                                    @item.ImageUrl
                                </td>
                                <td>
                                    @item.Status
                                    
                                </td>

                            
                                <td>
                                    <a href="/Admin/FeatureSlider/Delete/@item.Id" class="btn btn-danger">Sil</a>
                                </td>
                                <td>
                                    <a href="/Admin/FeatureSlider/Update/@item.Id" class="btn btn-info">Güncelle</a>
                                </td>

                            </tr>
                        }


                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

