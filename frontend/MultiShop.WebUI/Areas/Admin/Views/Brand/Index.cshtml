@model List<ResultBrandDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <a class="btn btn-primary mb-3" href="/Admin/Brand/Create">
                Yeni Marka
            </a>
            <br>
            <div class="table-responsive pt-3">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>
                                Id
                            </th>
                            <th>
                               Marka Adı
                            </th>
                            <th>
                                Resim
                            </th>
                          
                            <th>
                                Sil
                            </th>
                            <th>
                                Güncelle
                            </th>

                        </tr>
                    </thead>
                    
                    <tbody>
                        @foreach (var Brand in Model)
                        {
                            <tr>
                                <td>
                                    @Brand.Id
                                </td>
                                <td>
                                    @Brand.Name
                                </td>
                                <td>
                                    @Brand.ImageUrl
                                </td>
                               
                                <td>
                                    <a href="/Admin/Brand/DeleteBrand/@Brand.Id" class="btn btn-danger">Sil</a>
                                </td>
                                <td>
                                    <a href="/Admin/Brand/UpdateBrand/@Brand.Id" class="btn btn-info">Güncelle</a>
                                </td>

                            </tr>
                        }


                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

